{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Workspace Capability Resolution and Runtime Isolation",
    "subtitle": "Reusable models plus typed built-in/project capability overlay become one immutable Run profile",
    "output": "docs/diagrams/traqen-product-architecture/workspace-capability-resolution.dataflow.html",
    "animation": "trace",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "viewBox": [1280, 900],
    "views": [
      {
        "id": "model-selection",
        "label": "Model selection",
        "focus": ["models", "draft", "resolver", "profile"],
        "note": "Workspace slots select reusable API or allowlisted CLI profiles; activation pins exact revisions."
      },
      {
        "id": "overlay-disable",
        "label": "Overlay + disable",
        "focus": ["builtin", "project", "disabled", "resolver", "profile"],
        "note": "Project typed keys fully override built-ins, then Workspace disabled keys remove merged entries."
      },
      {
        "id": "scoped-secrets",
        "label": "Scoped secrets",
        "focus": ["vault", "draft", "resolver", "profile"],
        "note": "Profiles retain handles and least-privilege grants, never plaintext credentials."
      },
      {
        "id": "runtime-pinning",
        "label": "Runtime pinning",
        "focus": ["profile", "main", "children"],
        "note": "One Main and Child slots 2..N receive only the Run-pinned immutable profile."
      }
    ]
  },
  "stages": [
    {"label": "Sources"},
    {"label": "Workspace intent"},
    {"label": "Resolve + validate"},
    {"label": "Immutable revision"},
    {"label": "Runtime mount"}
  ],
  "nodes": [
    {
      "id": "models",
      "type": "database",
      "label": "Global models",
      "sublabel": "API / allowlisted CLI",
      "stage": 0,
      "row": 0,
      "tag": "reusable revisions",
      "width": 128
    },
    {
      "id": "builtin",
      "type": "database",
      "label": "Built-in catalog",
      "sublabel": "Skill / MCP · read-only",
      "stage": 0,
      "row": 1,
      "tag": "may be empty",
      "width": 128
    },
    {
      "id": "project",
      "type": "database",
      "label": "Project catalog",
      "sublabel": "immutable artifacts",
      "stage": 0,
      "row": 2,
      "tag": "Workspace owned",
      "width": 128
    },
    {
      "id": "vault",
      "type": "security",
      "label": "Secret vault",
      "sublabel": "credential handles",
      "stage": 0,
      "row": 3,
      "tag": "no plaintext"
    },
    {
      "id": "draft",
      "type": "frontend",
      "label": "Workspace draft",
      "sublabel": "Main + Child 2..N",
      "stage": 1,
      "row": 0,
      "tag": "durable + editable",
      "width": 132
    },
    {
      "id": "disabled",
      "type": "security",
      "label": "Disabled keys",
      "sublabel": "kind + normalized name",
      "stage": 1,
      "row": 4,
      "tag": "after overlay",
      "width": 132
    },
    {
      "id": "resolver",
      "type": "backend",
      "label": "Profile resolver",
      "sublabel": "overlay · disable · grants",
      "stage": 2,
      "row": 2,
      "tag": "deterministic",
      "width": 134
    },
    {
      "id": "profile",
      "type": "database",
      "label": "Execution profile",
      "sublabel": "immutable revision",
      "stage": 3,
      "row": 2,
      "tag": "digest pinned",
      "width": 126
    },
    {
      "id": "main",
      "type": "backend",
      "label": "Main Agent",
      "sublabel": "plan + reconcile",
      "stage": 4,
      "row": 0,
      "tag": "profile only"
    },
    {
      "id": "children",
      "type": "backend",
      "label": "Child roster",
      "sublabel": "2..N same-batch slots",
      "stage": 4,
      "row": 4,
      "tag": "profile only",
      "width": 122
    }
  ],
  "flows": [
    {
      "id": "models-draft",
