      { "id": "workspace-draft", "label": "Workspace draft", "focus": ["workspaceDraft", "localCapabilities", "resolver"], "note": "A Workspace may disable inherited capabilities or add independent local ones, then explicitly grant them to Agents." },
      { "id": "run-pinning", "label": "Run pinning", "focus": ["resolver", "activeProfile", "runSnapshot", "main", "children"], "note": "Apply produces an immutable active configuration; start pins it into a non-secret snapshot for Main and Child Agents." }
