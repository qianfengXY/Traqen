    { "id": "cliModels", "type": "database", "label": "Global CLI Models", "sublabel": "allowlisted adapter + Account", "stage": 0, "row": 1, "tag": "CLI only" },
    { "id": "globalCapabilities", "type": "database", "label": "Global Skill / MCP", "sublabel": "active lifecycle ceiling", "stage": 0, "row": 2, "tag": "not granted" },
    { "id": "secretRefs", "type": "security", "label": "Secret References", "sublabel": "resolved only at local CLI launch", "stage": 0, "row": 4, "tag": "scoped" },
