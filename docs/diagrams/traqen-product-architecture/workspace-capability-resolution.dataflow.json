  "cards": [
    { "dot": "cyan", "title": "F006 authority boundary", "items": ["The F006 settings surface lists, creates, and verifies only Account-backed local CLI models", "Legacy direct-API model profiles remain compatibility history and cannot be selected, applied, or started by F006", "OAuth login is performed by the installed CLI; Traqen only rechecks its local status"] },
    { "dot": "emerald", "title": "Explicit Workspace control", "items": ["Global active Skill/MCP assets become available, never automatically granted", "A Workspace may disable an inherited asset or add an independent local asset", "Agent capability use is the effective Workspace set intersected with explicit grants"] },
    { "dot": "rose", "title": "Pinned runtime isolation", "items": ["Apply and Start have separate immutable boundaries", "Runs mount a non-secret snapshot, not mutable global registries", "Deletion only blocks a new run when its active configuration actually grants the unavailable asset"] }
  ]
