    },
    {
      "id": "builtin-resolver",
      "from": "builtin",
      "to": "resolver",
      "label": "built-ins",
      "classification": "read-only catalog",
      "variant": "dashed",
      "route": "auto"
    },
    {
      "id": "project-resolver",
      "from": "project",
      "to": "resolver",
      "label": "overrides",
      "classification": "full-key override",
      "variant": "default",
      "route": "straight",
      "labelAt": [250, 342]
    },
    {
      "id": "disabled-resolver",
      "from": "disabled",
      "to": "resolver",
      "label": "disabled",
      "classification": "fail closed",
      "variant": "security",
      "route": "auto"
    },
    {
      "id": "vault-resolver",
      "from": "vault",
      "to": "resolver",
      "label": "handles",
      "classification": "secret metadata",
      "variant": "security",
      "route": "auto"
    },
    {
      "id": "resolver-profile",
      "from": "resolver",
      "to": "profile",
      "label": "effective set",
      "classification": "resolved set",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "profile-main",
      "from": "profile",
      "to": "main",
      "label": "Main",
      "classification": "runtime mount",
      "variant": "emphasis",
      "route": "auto"
    },
    {
      "id": "profile-children",
      "from": "profile",
      "to": "children",
      "label": "Child 2..N",
      "classification": "runtime mount",
      "variant": "emphasis",
      "route": "auto"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Separate Authorities",
      "items": [
        "Global models are reusable connection assets, not templates",
        "Built-in catalogs are read-only and may be empty",
        "Project capability revisions and disabled keys belong to one Workspace",
        "Draft intent remains editable after a Run starts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Effective Set",
      "items": [
        "Skill and MCP identity includes kind plus normalized name",
        "Project same-key entries completely replace built-ins",
        "Disable applies after overlay and never falls back",
        "Agent grants further narrow the effective catalog"
      ]
    },
    {
      "dot": "rose",
      "title": "Pinned Runtime Boundary",
      "items": [
        "Activation creates one immutable execution-profile revision",
        "Runtime receives no mutable model or capability registry handle",
        "Active and paused Runs keep their start revision",
        "Secrets remain scoped by Workspace, Run, and Agent slot"
      ]
    }
  ]
}
