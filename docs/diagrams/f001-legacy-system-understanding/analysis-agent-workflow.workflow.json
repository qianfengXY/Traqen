{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "F001 Analysis Agent Workflow",
    "subtitle": "Inventory 分区、动态 WorkUnit DAG、能力路由与选择性多模型对账",
    "output": "analysis-agent-workflow.html",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "viewBox": [780, 1280],
    "views": [
      {
        "id": "partition-plan",
        "label": "确定性分区",
        "focus": ["inventory", "partition", "route"],
        "note": "五步分区从完整 Inventory 产生稳定 UnderstandingPlan，并保证 unassignedCount = 0。"
      },
      {
        "id": "hierarchical-analysis",
        "label": "层级分析",
        "focus": ["leaf", "facts", "module", "cross_module", "critic", "reconcile", "bundle"],
        "note": "有界叶子单元逐层汇总；任何 Candidate 都必须回到 SourceSlice 和 / 或允许 Fact。"
      },
      {
        "id": "failure-honesty",
        "label": "失败与缺口",
        "focus": ["route", "no_producer", "critic", "gap"],
        "note": "无合格 Producer、预算触顶和未解决冲突都形成显式 Gap，不伪造完成。"
      }
    ]
  },
  "lanes": [
    {
      "id": "planning",
      "label": "Planning"
    },
    {
      "id": "routing",
      "label": "Model / Skill Routing"
    },
    {
      "id": "source",
      "label": "Source + Facts"
    },
    {
      "id": "synthesis",
      "label": "File / Module Synthesis"
    },
    {
      "id": "crosscutting",
      "label": "Cross-module Synthesis"
    },
    {
      "id": "review",
      "label": "Critic + Reconciliation"
    },
    {
      "id": "output",
      "label": "Candidate Output"
    },
    {
      "id": "exceptions",
      "label": "Explicit Gaps",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "plan_phase",
      "label": "Plan + Route + Read",
      "fromCol": 0,
      "toCol": 2,
      "variant": "security"
    },
    {
      "id": "synthesis_phase",
      "label": "Synthesize",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "reconcile_phase",
      "label": "Reconcile",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "plan_group",
      "label": "Stable UnderstandingPlan",
      "lane": "planning",
      "fromCol": 0,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "dag_group",
      "label": "Bounded WorkUnits",
      "lane": "synthesis",
      "fromCol": 3,
      "toCol": 5,
      "variant": "emphasis"
    },
    {
      "id": "gap_group",
      "label": "No silent completion",
      "lane": "exceptions",
      "fromCol": 0,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": ["inventory", "partition", "route", "leaf", "module", "cross_module", "critic", "reconcile", "bundle"],
  "nodes": [
    {
      "id": "inventory",
      "lane": "planning",
      "col": 0,
      "type": "database",
      "label": "Inventory",
      "sublabel": "all artifacts",
      "tag": "all dispositions"
    },
    {
      "id": "partition",
      "lane": "planning",
      "col": 2,
      "type": "backend",
      "label": "Partition",
      "sublabel": "stable plan",
      "tag": "stable IDs"
    },
    {
      "id": "route",
      "lane": "routing",
      "col": 2,
      "type": "security",
      "label": "Router",
      "sublabel": "model + Skill",
      "tag": "AnalysisRouteDecision"
    },
    {
      "id": "leaf",
      "lane": "source",
      "col": 2,
      "type": "backend",
      "label": "Leaf",
      "sublabel": "raw slices",
      "tag": "local / private",
      "width": 70
    },
    {
      "id": "facts",
      "lane": "source",
      "col": 0,
      "type": "database",
      "label": "Facts",
      "sublabel": "optional",
      "tag": "not task universe",
      "width": 70
    },
    {
      "id": "module",
      "lane": "synthesis",
      "col": 3,
      "type": "backend",
      "label": "Module",
      "sublabel": "file / module",
      "width": 70
    },
    {
      "id": "cross_module",
      "lane": "crosscutting",
      "col": 3,
      "type": "backend",
      "label": "Cross",
      "sublabel": "workflow / state",
      "tag": "bounded evidence",
      "width": 70
    },
    {
      "id": "critic",
      "lane": "review",
      "col": 3,
      "type": "security",
      "label": "Critic",
      "sublabel": "independent",
      "tag": "high-risk only"
    },
    {
      "id": "reconcile",
      "lane": "review",
      "col": 5,
      "type": "backend",
      "label": "Reconcile",
      "sublabel": "evidence first",
      "tag": "no majority vote"
    },
    {
      "id": "bundle",
      "lane": "output",
      "col": 5,
      "type": "database",
      "label": "Bundles",
      "sublabel": "source-linked"
    },
    {
      "id": "no_producer",
      "lane": "exceptions",
      "col": 0,
      "type": "security",
      "label": "No Producer",
      "sublabel": "fail closed"
    },
    {
      "id": "gap",
      "lane": "exceptions",
      "col": 3,
      "type": "external",
      "label": "Gaps",
      "sublabel": "budget / dispute",
      "tag": "human review if high risk"
    }
  ],
  "edges": [
    {
      "id": "inventory-partition",
      "from": "inventory",
      "to": "partition",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "partition-route",
      "from": "partition",
      "to": "route",
      "variant": "security",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "route-leaf",
      "from": "route",
      "to": "leaf",
      "variant": "security",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "leaf-module",
      "from": "leaf",
      "to": "module",
      "variant": "emphasis",
      "role": "main",
      "route": "drop"
    },
    {
      "id": "facts-leaf",
      "from": "facts",
      "to": "leaf",
      "variant": "dashed",
      "role": "async",
      "route": "straight"
    },
    {
      "id": "module-cross",
      "from": "module",
      "to": "cross_module",
      "variant": "emphasis",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "cross-critic",
      "from": "cross_module",
      "to": "critic",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "critic-reconcile",
      "from": "critic",
      "to": "reconcile",
      "variant": "security",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "reconcile-bundle",
      "from": "reconcile",
      "to": "bundle",
      "variant": "emphasis",
      "role": "main",
      "route": "straight"
    },
    {
      "id": "route-no-producer",
      "from": "route",
      "to": "no_producer",
      "variant": "security",
      "role": "error",
      "route": "return-left"
    },
    {
      "id": "no-producer-gap",
      "from": "no_producer",
      "to": "gap",
      "variant": "security",
      "role": "error",
      "route": "straight"
    },
    {
      "id": "critic-gap",
      "from": "critic",
      "to": "gap",
      "variant": "dashed",
      "role": "error",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "分区不变量",
      "items": [
        "一个 Artifact 只有一种基础处置，SourceRange 可有有界重叠",
        "相同 Snapshot / Planner / Policy 产生相同 Partition ID",
        "direct + specialist + disposition + unassigned = Inventory 总数"
      ]
    },
    {
      "dot": "violet",
      "title": "模型与 Skill",
      "items": [
        "Role 分为 SOURCE_READER、MODULE_SYNTHESIS、CROSS_MODULE_REASONING、CRITIC",
        "模型 Revision 必须先通过语言、证据、Schema、数据边界校准",
        "Direct-source Skill 不强制依赖 FactBundle"
      ]
    },
    {
      "dot": "rose",
      "title": "多模型对账",
      "items": [
        "默认按 Partition 选择最合适 Producer 并行运行",
        "只对高风险、低置信、矛盾或抽样范围启用独立 Critic",
        "一致只提高有上限的佐证，分歧保留，票数不创建真相"
      ]
    }
  ]
}
