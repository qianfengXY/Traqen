{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.example/schemas/fact-bundle-v1alpha1.json",
  "title": "FactBundle",
  "type": "object",
  "required": [
    "id", "projectId", "snapshotManifestId", "sourceComponentId", "sourceDigest", "extractor",
    "observedAt", "complete", "diagnostics", "nodes", "edges", "attestation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FACT-BUNDLE-[a-f0-9]{24}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "sourceComponentId": { "type": "string", "minLength": 1 },
    "sourceDigest": { "$ref": "#/$defs/Sha256" },
    "extractor": { "$ref": "#/$defs/Extractor" },
    "observedAt": { "type": "string", "format": "date-time" },
    "complete": { "type": "boolean" },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/FactNode" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/FactEdge" }
    },
    "attestation": { "$ref": "#/$defs/Attestation" }
  },
  "additionalProperties": false,
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Extractor": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "SourceLocation": {
      "type": "object",
      "required": ["artifact", "startLine", "endLine", "contentHash"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/Sha256" }
      },
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "required": ["severity", "artifact", "message"],
      "properties": {
        "severity": { "enum": ["INFO", "WARNING", "ERROR"] },
        "artifact": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "FactNode": {
      "type": "object",
      "required": [
        "id", "factId", "projectId", "snapshotManifestId", "type", "naturalKey",
        "name", "attributes", "source", "extractor", "observedAt", "validFrom", "validTo"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^FACT-NODE-[a-f0-9]{24}$" },
        "factId": { "type": "string", "pattern": "^FACT-[a-f0-9]{24}$" },
        "projectId": { "type": "string", "minLength": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "ARTIFACT", "MODULE", "CODE_SYMBOL", "ENDPOINT", "DATA_OBJECT",
            "CONFIGURATION", "EXTERNAL_DEPENDENCY", "TEST_ASSET"
          ]
        },
        "naturalKey": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object" },
        "source": { "$ref": "#/$defs/SourceLocation" },
        "extractor": { "$ref": "#/$defs/Extractor" },
        "observedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "FactEdge": {
      "type": "object",
      "required": [
        "id", "projectId", "snapshotManifestId", "subjectId", "predicate", "objectId",
        "attributes", "source", "extractor", "observedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^FACT-EDGE-[a-f0-9]{24}$" },
        "projectId": { "type": "string", "minLength": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "subjectId": { "type": "string", "pattern": "^FACT-NODE-[a-f0-9]{24}$" },
        "predicate": {
          "enum": [
            "CONTAINS", "IMPLEMENTED_BY", "CALLS", "READS", "WRITES",
            "CONTROLLED_BY", "DEPENDS_ON", "EXERCISES"
          ]
        },
        "objectId": { "type": "string", "pattern": "^FACT-NODE-[a-f0-9]{24}$" },
        "attributes": { "type": "object" },
        "source": { "$ref": "#/$defs/SourceLocation" },
        "extractor": { "$ref": "#/$defs/Extractor" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ScannerAttestation": {
      "type": "object",
      "required": ["algorithm", "extractorId", "signature"],
      "properties": {
        "algorithm": { "const": "HMAC-SHA256" },
        "extractorId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "ServerNormalizedAttestation": {
      "type": "object",
      "required": ["algorithm", "extractorId", "signature"],
      "properties": {
        "algorithm": { "const": "SERVER-NORMALIZED-SHA256" },
        "extractorId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "Attestation": {
      "oneOf": [
        { "$ref": "#/$defs/ScannerAttestation" },
        { "$ref": "#/$defs/ServerNormalizedAttestation" }
      ]
    },
    "StoredFactBundle": {
      "type": "object",
      "required": ["bundleId", "snapshotManifestId", "sourceComponentId", "nodeCount", "edgeCount", "complete"],
      "properties": {
        "bundleId": { "type": "string" },
        "snapshotManifestId": { "type": "string" },
        "sourceComponentId": { "type": "string" },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "FactGraph": {
      "type": "object",
      "required": ["bundles", "matchedNodeIds", "nodes", "edges", "truncated", "edgesTruncated"],
      "properties": {
        "bundles": { "type": "array", "items": { "type": "object" } },
        "matchedNodeIds": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } },
        "truncated": { "type": "boolean" },
        "edgesTruncated": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
