{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.local/contracts/analysis-agent.schema.json",
  "title": "AnalysisRunRequest",
  "type": "object",
  "required": ["id", "projectId", "snapshotManifestId", "sourceComponentId", "profile"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "sourceComponentId": { "type": "string", "minLength": 1 },
    "baselineRunId": { "type": ["string", "null"], "minLength": 1 },
    "mode": { "enum": ["FULL", "INCREMENTAL", "AUTO"] },
    "profile": { "$ref": "#/$defs/Profile" },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "Profile": {
      "type": "object",
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["DETERMINISTIC", "HYBRID"] },
        "model": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "profileId": { "type": ["string", "null"], "minLength": 1, "description": "Explicit verified model profile; null uses the currently selected server profile" },
            "contextWindow": { "type": "integer", "minimum": 1 },
            "maxInputTokens": { "type": "integer", "minimum": 1 },
            "maxOutputTokens": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "maxAttemptsPerWorkUnit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "WorkUnit": {
      "type": "object",
      "required": ["id", "runId", "scopeKey", "rootNodeId", "nodeIds", "edgeIds", "estimatedTokens", "inputDigest", "status", "attempts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "scopeKey": { "type": "string", "minLength": 1 },
        "rootNodeId": { "type": "string", "minLength": 1 },
        "nodeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "edgeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "estimatedTokens": { "type": "integer", "minimum": 1 },
        "inputDigest": { "type": "string", "minLength": 1 },
        "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED"] },
        "attempts": { "type": "array", "items": { "type": "object" } },
        "output": { "type": ["object", "null"] },
        "error": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "Checkpoint": {
      "type": "object",
      "required": ["request", "run", "factFingerprint", "changedStableIds", "workUnits", "result"],
      "properties": {
        "request": { "$ref": "#" },
        "run": {
          "type": "object",
          "required": ["id", "projectId", "snapshotManifestId", "effectiveMode", "status", "profile", "plannedWorkUnitCount", "completedWorkUnitCount", "failedWorkUnitCount", "startedAt", "updatedAt"],
          "properties": {
            "id": { "type": "string" },
            "projectId": { "type": "string" },
            "snapshotManifestId": { "type": "string" },
            "baselineRunId": { "type": ["string", "null"] },
            "requestedMode": { "enum": ["FULL", "INCREMENTAL", "AUTO"] },
            "effectiveMode": { "enum": ["FULL", "INCREMENTAL"] },
            "status": { "enum": ["RUNNING", "PAUSED", "COMPLETED", "COMPLETED_WITH_GAPS", "CANCELLED"] },
            "profile": { "$ref": "#/$defs/Profile" },
            "plannedWorkUnitCount": { "type": "integer", "minimum": 0 },
            "unchangedWorkUnitCount": { "type": "integer", "minimum": 0 },
            "changedFactCount": { "type": "integer", "minimum": 0 },
            "completedWorkUnitCount": { "type": "integer", "minimum": 0 },
            "failedWorkUnitCount": { "type": "integer", "minimum": 0 },
            "startedAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "completedAt": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        },
        "factFingerprint": { "type": "object", "additionalProperties": { "type": "string" } },
        "changedStableIds": { "type": "array", "items": { "type": "string" } },
        "workUnits": { "type": "array", "items": { "$ref": "#/$defs/WorkUnit" } },
        "result": { "oneOf": [{ "$ref": "#/$defs/Result" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "AnalyzedFeature": {
      "type": "object",
      "required": ["id", "revision", "candidateKey", "mode", "name", "description", "authority", "change", "evidenceFactIds", "stableEvidenceNodeIds", "analysisRunId", "snapshotManifestId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "candidateKey": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["BUSINESS", "API"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "authority": { "type": "object" },
        "change": { "type": "object" },
        "evidenceFactIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "stableEvidenceNodeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "design": { "type": "object" },
        "provenance": { "type": "array", "items": { "type": "object" } },
        "uncertainties": { "type": "array", "items": { "type": "string" } },
        "digests": { "type": "object" },
        "analysisRunId": { "type": "string" },
        "snapshotManifestId": { "type": "string" },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "required": ["id", "projectId", "snapshotManifestId", "mode", "profile", "status", "coverage", "factFingerprint", "features", "retiredFeatures", "completedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "baselineRunId": { "type": ["string", "null"] },
        "mode": { "enum": ["FULL", "INCREMENTAL"] },
        "profile": { "$ref": "#/$defs/Profile" },
        "status": { "enum": ["COMPLETED", "COMPLETED_WITH_GAPS"] },
        "coverage": { "type": "object" },
        "factFingerprint": { "type": "object", "additionalProperties": { "type": "string" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/AnalyzedFeature" } },
        "retiredFeatures": { "type": "array", "items": { "type": "object" } },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
