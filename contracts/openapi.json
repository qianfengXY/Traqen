{
  "openapi": "3.1.0",
  "info": {
    "title": "Traqen Traceability API",
    "version": "0.1.0",
    "description": "API for deterministic fact ingestion, controlled Reverse Skill runs, authorized statement-level governance, server-derived Feature traceability, layered Snapshot impact, TestSpec validation, and attested execution Evidence ingestion. The local development server is not a production authentication boundary; Decision and candidate-review operations fail closed without configured reviewer identity."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API process is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "const": "ok" } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/trace-chains/evaluate": {
      "post": {
        "operationId": "evaluateTraceChain",
        "requestBody": { "$ref": "#/components/requestBodies/TraceChainEvaluation" },
        "responses": {
          "200": {
            "description": "Deterministically evaluated trace chain",
            "content": {
              "application/json": { "schema": { "$ref": "./trace-chain.schema.json" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/trace-chains": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" }
      ],
      "post": {
        "operationId": "evaluateAndPersistTraceChain",
        "requestBody": { "$ref": "#/components/requestBodies/TraceChainEvaluation" },
        "responses": {
          "201": {
            "description": "Trace chain revision appended",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["chain", "persisted"],
                  "properties": {
                    "chain": { "$ref": "./trace-chain.schema.json" },
                    "persisted": {
                      "type": "object",
                      "required": ["chainId", "revision"],
                      "properties": {
                        "chainId": { "type": "string" },
                        "revision": { "type": "integer", "minimum": 1 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/trace-chains/{chainId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ChainId" }
      ],
      "get": {
        "operationId": "getCurrentTraceChain",
        "responses": {
          "200": {
            "description": "Current trace-chain revision",
            "content": {
              "application/json": { "schema": { "$ref": "./trace-chain.schema.json" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/features": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "appendFeatureVersion",
        "requestBody": { "$ref": "#/components/requestBodies/FeatureVersion" },
        "responses": {
          "201": { "$ref": "#/components/responses/FeatureVersionCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/claim-scopes": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "appendClaimScope",
        "requestBody": { "$ref": "#/components/requestBodies/ClaimScope" },
        "responses": {
          "201": { "$ref": "#/components/responses/ClaimScopeCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/claims": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "appendClaim",
        "requestBody": { "$ref": "#/components/requestBodies/Claim" },
        "responses": {
          "201": { "$ref": "#/components/responses/ClaimCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/decisions": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "appendDecision",
        "requestBody": { "$ref": "#/components/requestBodies/Decision" },
        "responses": {
          "201": { "$ref": "#/components/responses/DecisionCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/ReviewerUnauthenticated" },
          "403": { "$ref": "#/components/responses/ReviewerForbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/features/{featureId}/baseline": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        {
          "name": "featureId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "get": {
        "operationId": "getFeatureBaseline",
        "responses": {
          "200": {
            "description": "Latest feature version with current claims, decision history, linked TestSpecs, and trace chains",
            "content": {
              "application/json": {
                "schema": { "$ref": "./governance.schema.json#/$defs/FeatureBaseline" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/features/{featureId}/traceability": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        {
          "name": "featureId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        },
        {
          "name": "snapshotManifestId",
          "in": "query",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "get": {
        "operationId": "getFeatureTraceability",
        "responses": {
          "200": { "$ref": "#/components/responses/FeatureTraceability" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/features/{featureId}/trace-chains/recompute": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        {
          "name": "featureId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "post": {
        "operationId": "recomputeFeatureTraceChains",
        "requestBody": { "$ref": "#/components/requestBodies/TraceChainRecompute" },
        "responses": {
          "201": { "$ref": "#/components/responses/FeatureTraceability" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/change-sets": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "compareSnapshotManifests",
        "requestBody": { "$ref": "#/components/requestBodies/ChangeSetComparison" },
        "responses": {
          "201": { "$ref": "#/components/responses/ChangeImpact" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/change-sets/{changeSetId}/impact": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        {
          "name": "changeSetId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "get": {
        "operationId": "getChangeImpact",
        "responses": {
          "200": { "$ref": "#/components/responses/ChangeImpact" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/test-specs": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "appendTestSpec",
        "requestBody": { "$ref": "#/components/requestBodies/TestSpecDraft" },
        "responses": {
          "201": { "$ref": "#/components/responses/TestSpecCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/features/{featureId}/claims/{claimId}/test-spec-drafts": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        {
          "name": "featureId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        },
        {
          "name": "claimId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "post": {
        "operationId": "generateTestSpecDraft",
        "requestBody": { "$ref": "#/components/requestBodies/TestSpecGeneration" },
        "responses": {
          "201": { "$ref": "#/components/responses/TestSpecGenerated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/test-specs/{testSpecId}/approvals": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/TestSpecId" }
      ],
      "post": {
        "operationId": "approveTestSpec",
        "requestBody": { "$ref": "#/components/requestBodies/TestSpecApproval" },
        "responses": {
          "201": { "$ref": "#/components/responses/TestSpecCreated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/ReviewerUnauthenticated" },
          "403": { "$ref": "#/components/responses/ReviewerForbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/projects/{projectId}/test-specs/validate": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "validateTestSpecCandidate",
        "requestBody": { "$ref": "#/components/requestBodies/TestSpecCandidate" },
        "responses": {
          "200": { "$ref": "#/components/responses/TestSpecValidation" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/test-specs/{testSpecId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/TestSpecId" },
        { "$ref": "#/components/parameters/Version" }
      ],
      "get": {
        "operationId": "getTestSpec",
        "responses": {
          "200": { "$ref": "#/components/responses/TestSpecFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/test-specs/{testSpecId}/validate": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/TestSpecId" },
        { "$ref": "#/components/parameters/Version" }
      ],
      "post": {
        "operationId": "validateStoredTestSpec",
        "responses": {
          "200": { "$ref": "#/components/responses/TestSpecValidation" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/test-executions": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "ingestExecutionEvidence",
        "requestBody": { "$ref": "#/components/requestBodies/ExecutionEvidenceBundle" },
        "responses": {
          "201": { "$ref": "#/components/responses/ExecutionEvidenceStored" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/RunnerUnauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/test-executions/{executionId}/evidence": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ExecutionId" }
      ],
      "get": {
        "operationId": "getExecutionEvidence",
        "responses": {
          "200": { "$ref": "#/components/responses/ExecutionEvidenceFound" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/fact-scans": {
      "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
      "post": {
        "operationId": "ingestFactBundle",
        "requestBody": { "$ref": "#/components/requestBodies/FactBundle" },
        "responses": {
          "201": { "$ref": "#/components/responses/FactBundleStored" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/ScannerUnauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/facts": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "name": "snapshotManifestId", "in": "query", "schema": { "type": "string" } },
        { "name": "type", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "predicate", "in": "query", "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 256 } },
        { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500 } }
      ],
      "get": {
        "operationId": "queryFacts",
        "responses": {
          "200": {
            "description": "Matching facts plus their one-hop graph neighbors",
            "content": { "application/json": { "schema": { "$ref": "./fact-bundle.schema.json#/$defs/FactGraph" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/skills": {
      "get": {
        "operationId": "listReverseSkills",
        "responses": {
          "200": {
            "description": "Current registration state for every installed Skill version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["skills"],
                  "properties": {
                    "skills": {
                      "type": "array",
                      "items": { "$ref": "./reverse-skill.schema.json#/$defs/StoredRegistration" }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerReverseSkill",
        "requestBody": { "$ref": "#/components/requestBodies/ReverseSkillRegistration" },
        "responses": {
          "201": { "$ref": "#/components/responses/ReverseSkillRegistered" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/SkillUnauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/reverse-runs": {
      "post": {
        "operationId": "executeReverseRun",
        "requestBody": { "$ref": "#/components/requestBodies/ReverseRun" },
        "responses": {
          "201": { "$ref": "#/components/responses/ReverseRunFound" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/v1/projects/{projectId}/reverse-runs/{runId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ReverseRunId" }
      ],
      "get": {
        "operationId": "getReverseRun",
        "responses": {
          "200": { "$ref": "#/components/responses/ReverseRunFound" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/reverse-runs/{runId}/reviews": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ReverseRunId" }
      ],
      "get": {
        "operationId": "listReverseCandidateReviews",
        "responses": {
          "200": { "$ref": "#/components/responses/CandidateReviewList" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/projects/{projectId}/reverse-runs/{runId}/candidates/{candidateId}/reviews": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ReverseRunId" },
        {
          "name": "candidateId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "minLength": 1 }
        }
      ],
      "post": {
        "operationId": "reviewReverseCandidate",
        "requestBody": { "$ref": "#/components/requestBodies/CandidateReview" },
        "responses": {
          "201": { "$ref": "#/components/responses/CandidateReviewed" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/ReviewerUnauthenticated" },
          "403": { "$ref": "#/components/responses/ReviewerForbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      },
      "ChainId": {
        "name": "chainId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      },
      "TestSpecId": {
        "name": "testSpecId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      },
      "Version": {
        "name": "version",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "ExecutionId": {
        "name": "executionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      },
      "ReverseRunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "requestBodies": {
      "TraceChainEvaluation": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "./trace-chain-evaluation-input.schema.json" }
          }
        }
      },
      "FeatureVersion": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "./governance.schema.json#/$defs/FeatureVersion" } } }
      },
      "ClaimScope": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "./governance.schema.json#/$defs/ClaimScope" } } }
      },
      "Claim": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "./governance.schema.json#/$defs/Claim" } } }
      },
      "Decision": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "./governance.schema.json#/$defs/DecisionRequest" } } }
      },
      "TestSpecDraft": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "./test-spec-generation.schema.json#/$defs/ManualDraftRequest" }
          }
        }
      },
      "TestSpecCandidate": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "./test-spec-generation.schema.json#/$defs/CandidateRequest" }
          }
        }
      },
      "TestSpecGeneration": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./test-spec-generation.schema.json" } }
        }
      },
      "TestSpecApproval": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "./test-spec-generation.schema.json#/$defs/ApprovalRequest" }
          }
        }
      },
      "ExecutionEvidenceBundle": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./execution-evidence.schema.json" } }
        }
      },
      "FactBundle": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./fact-bundle.schema.json" } }
        }
      },
      "ReverseSkillRegistration": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./reverse-skill.schema.json" } }
        }
      },
      "ReverseRun": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./reverse-run.schema.json" } }
        }
      },
      "CandidateReview": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "./candidate-review.schema.json" } }
        }
      },
      "TraceChainRecompute": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["snapshotManifestId"],
              "properties": { "snapshotManifestId": { "type": "string", "minLength": 1 } },
              "additionalProperties": false
            }
          }
        }
      },
      "ChangeSetComparison": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "./change-impact.schema.json#/$defs/ChangeSetRequest" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "details": {}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
