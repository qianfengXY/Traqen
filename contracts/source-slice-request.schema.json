{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/source-slice-request.schema.json",
  "title": "SourceSliceHttpRequest",
  "type": "object",
  "required": ["snapshotManifestId", "selectors", "policyDigest"],
  "properties": {
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "producerRef": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifactId"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "symbolId": { "type": ["string", "null"] },
          "startByte": { "type": "integer", "minimum": 0, "default": 0 },
          "endByte": { "type": ["integer", "null"], "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "allowedFactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "maxBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "maxTokens": { "type": "integer", "minimum": 1, "maximum": 12000 },
    "policyDigest": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
