{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.example/schemas/execution-evidence-v1alpha1.json",
  "title": "ExecutionEvidenceBundle",
  "type": "object",
  "required": ["execution", "evidence", "attestation"],
  "properties": {
    "execution": { "$ref": "#/$defs/TestExecution" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Evidence" }
    },
    "attestation": { "$ref": "#/$defs/RunnerAttestation" }
  },
  "additionalProperties": false,
  "$defs": {
    "SnapshotComponent": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "SnapshotComponents": {
      "type": "object",
      "required": ["source", "build", "deployment", "runtime"],
      "properties": {
        "source": { "$ref": "#/$defs/SnapshotComponent" },
        "build": { "$ref": "#/$defs/SnapshotComponent" },
        "deployment": { "$ref": "#/$defs/SnapshotComponent" },
        "runtime": { "$ref": "#/$defs/SnapshotComponent" }
      },
      "additionalProperties": false
    },
    "EvidenceManifest": {
      "type": "object",
      "required": [
        "executionId", "testSpecId", "testSpecVersion", "snapshotManifestId",
        "deploymentId", "runnerId", "runnerVersion", "snapshotComponents", "redactions"
      ],
      "properties": {
        "executionId": { "type": "string", "minLength": 1 },
        "testSpecId": { "type": "string", "minLength": 1 },
        "testSpecVersion": { "type": "integer", "minimum": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 },
        "runnerId": { "type": "string", "minLength": 1 },
        "runnerVersion": { "type": "string", "minLength": 1 },
        "snapshotComponents": { "$ref": "#/$defs/SnapshotComponents" },
        "redactions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "Runner": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "AssertionResult": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "SKIPPED"] },
        "message": { "type": ["string", "null"] },
        "actual": {}
      },
      "additionalProperties": true
    },
    "Attempt": {
      "type": "object",
      "required": [
        "number", "startedAt", "finishedAt", "phaseStatus",
        "setup", "stepResults", "assertionResults", "cleanup"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "phaseStatus": { "enum": ["PASS", "FAIL", "ERROR", "SKIPPED"] },
        "setup": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["PASS", "FAIL", "ERROR", "SKIPPED"] } },
          "additionalProperties": true
        },
        "stepResults": { "type": "array", "items": { "type": "object" } },
        "assertionResults": { "type": "array", "items": { "$ref": "#/$defs/AssertionResult" } },
        "cleanup": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["PASS", "FAIL", "ERROR", "SKIPPED"] } },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "TestExecution": {
      "type": "object",
      "required": [
        "id", "testSpecId", "testSpecVersion", "snapshotManifestId", "deploymentId",
        "runner", "completionReason", "status", "startedAt", "finishedAt", "attempts"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "testSpecId": { "type": "string", "minLength": 1 },
        "testSpecVersion": { "type": "integer", "minimum": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 },
        "runner": { "$ref": "#/$defs/Runner" },
        "completionReason": { "enum": ["COMPLETED", "SKIPPED", "CANCELLED"] },
        "status": { "enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "SKIPPED", "CANCELLED"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/Attempt" } }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": [
        "id", "executionId", "type", "freshness", "contentHash",
        "storageUri", "manifest", "createdAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "executionId": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["HTTP", "DATABASE", "LOG", "TRACE", "COVERAGE", "SCREENSHOT", "ASSERTION", "OTHER"]
        },
        "integrity": { "enum": ["VERIFIED", "UNVERIFIED", "INVALID"] },
        "freshness": { "enum": ["FRESH", "EXPIRING", "STALE", "INCOMPLETE"] },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "storageUri": { "type": ["string", "null"] },
        "manifest": { "$ref": "#/$defs/EvidenceManifest" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "RunnerAttestation": {
      "type": "object",
      "required": ["algorithm", "runnerId", "signature"],
      "properties": {
        "algorithm": { "const": "HMAC-SHA256" },
        "runnerId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "StoredExecutionEvidence": {
      "allOf": [
        { "$ref": "#" },
        {
          "properties": {
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/Evidence" },
                  { "required": ["integrity"] }
                ]
              }
            }
          }
        }
      ]
    },
    "TestExecutionSummary": {
      "type": "object",
      "required": [
        "id", "testSpecId", "testSpecVersion", "snapshotManifestId", "deploymentId",
        "status", "runner", "finishedAt", "evidenceCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "testSpecId": { "type": "string", "minLength": 1 },
        "testSpecVersion": { "type": "integer", "minimum": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "SKIPPED", "CANCELLED"] },
        "runner": { "oneOf": [{ "$ref": "#/$defs/Runner" }, { "type": "null" }] },
        "finishedAt": { "type": "string", "format": "date-time" },
        "evidenceCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
