{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.example/schemas/business-process-model-v1alpha1.json",
  "title": "BusinessProcessModel",
  "$ref": "#/$defs/Model",
  "$defs": {
    "FactRef": {
      "type": "object",
      "required": ["snapshotManifestId", "factId"],
      "properties": {
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "factId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "responsibilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["INITIAL", "INTERMEDIATE", "TERMINAL", "EXCEPTION"] },
        "description": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "required": ["id", "name", "fromStateId", "toStateId", "trigger", "actorIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fromStateId": { "type": "string", "minLength": 1 },
        "toStateId": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "actorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "guards": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exception": { "type": ["string", "null"], "minLength": 1 },
        "nextFeatureId": { "type": ["string", "null"], "minLength": 1 },
        "implementationFactRefs": { "type": "array", "items": { "$ref": "#/$defs/FactRef" } }
      },
      "additionalProperties": false
    },
    "DesignElement": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["MODULE", "SEQUENCE", "TRANSACTION", "EXCEPTION_HANDLER"] },
        "description": { "type": ["string", "null"], "minLength": 1 },
        "implementationFactRefs": { "type": "array", "items": { "$ref": "#/$defs/FactRef" } }
      },
      "additionalProperties": false
    },
    "Input": {
      "type": "object",
      "required": ["id", "version", "featureVersion", "name", "actors", "states", "transitions", "authority"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "featureVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"], "minLength": 1 },
        "actors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Actor" } },
        "states": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/State" } },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Transition" } },
        "designElements": { "type": "array", "items": { "$ref": "#/$defs/DesignElement" } },
        "authority": {
          "type": "object",
          "required": ["rationale"],
          "properties": {
            "rationale": { "type": "string", "minLength": 1 },
            "decisionRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": ["id", "version", "featureId", "featureVersion", "name", "description", "actors", "states", "transitions", "designElements", "authority", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "featureId": { "type": "string", "minLength": 1 },
        "featureVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"], "minLength": 1 },
        "actors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Actor" } },
        "states": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/State" } },
        "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Transition" } },
        "designElements": { "type": "array", "items": { "$ref": "#/$defs/DesignElement" } },
        "authority": {
          "type": "object",
          "required": ["actorId", "actorRole", "rationale", "decisionRefs", "confirmedAt"],
          "properties": {
            "actorId": { "type": "string", "minLength": 1 },
            "actorRole": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "decisionRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "confirmedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
