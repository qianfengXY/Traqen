{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/source-slice.schema.json",
  "title": "SourceSlice",
  "oneOf": [
    {
      "title": "SourceSliceRequest",
      "type": "object",
      "required": ["projectId", "snapshotManifestId", "analysisRunId", "workUnitId", "producerRef", "purpose", "selectors", "allowedFactIds", "maxBytes", "maxTokens", "policyId"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "snapshotManifestId": { "type": "string" },
        "analysisRunId": { "type": "string" },
        "workUnitId": { "type": "string" },
        "producerRef": { "type": "string" },
        "purpose": { "type": "string" },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["artifactId", "symbolId", "startByte", "endByte"],
            "properties": {
              "artifactId": { "type": "string" },
              "symbolId": { "type": ["string", "null"] },
              "startByte": { "type": "integer", "minimum": 0 },
              "endByte": { "type": ["integer", "null"], "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "allowedFactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "policyId": { "type": "string" }
        ,"requestedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "title": "SourceSliceResponse",
      "type": "object",
      "required": ["id", "requestId", "projectId", "snapshotManifestId", "analysisRunId", "workUnitId", "status", "artifactSlices", "factIds", "redactions", "contentDigest", "truncated", "omittedReasons", "diagnostics", "policyDecisionId", "responseDigest", "createdAt"],
      "properties": {
        "id": { "type": "string" }, "requestId": { "type": "string" },
        "projectId": { "type": "string" }, "snapshotManifestId": { "type": "string" },
        "analysisRunId": { "type": "string" }, "workUnitId": { "type": "string" },
        "status": { "enum": ["COMPLETE", "TRUNCATED", "REDACTED", "REJECTED"] },
        "artifactSlices": { "type": "array", "items": { "type": "object" } },
        "factIds": { "type": "array", "items": { "type": "string" } },
        "redactions": { "type": "array", "items": { "type": "object" } },
        "contentDigest": { "type": "string" }, "truncated": { "type": "boolean" },
        "omittedReasons": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "object" } },
        "policyDecisionId": { "type": "string" }, "responseDigest": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  ]
}
