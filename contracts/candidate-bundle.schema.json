{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/candidate-bundle.schema.json",
  "title": "CandidateBundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "snapshotManifestId",
    "analysisRunId",
    "workUnitId",
    "producedAt",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "analysisRunId": { "type": "string", "minLength": 1 },
    "workUnitId": { "type": "string", "minLength": 1 },
    "producedAt": { "type": "string", "format": "date-time" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/Candidate" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "WorkUnit": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "projectId",
        "snapshotManifestId",
        "analysisRunId",
        "factIds",
        "rootFactIds"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "snapshotManifestId": { "type": "string", "minLength": 1 },
        "analysisRunId": { "type": "string", "minLength": 1 },
        "factIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rootFactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "confidence",
        "confidenceCap",
        "evidenceFactIds",
        "proposal",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["CANDIDATE_FEATURE", "CANDIDATE_CLAIM"]
        },
        "status": { "const": "PENDING_REVIEW" },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "confidenceCap": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "evidenceFactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "proposal": {
          "$ref": "#/$defs/CandidateProposal"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Provenance" }
        }
      },
      "additionalProperties": false
    },
    "CandidateProposal": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "candidateKey": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["BUSINESS", "API"] },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "method": { "type": ["string", "null"] },
        "modulePath": { "type": "string" },
        "sourcePath": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": "string" },
        "evidence": { "$ref": "#/$defs/GovernanceFreeObject" },
        "displayName": { "type": "string", "minLength": 1 },
        "businessFeature": { "type": "boolean" },
        "businessKey": { "type": "string", "minLength": 1 },
        "businessModule": { "type": "string", "minLength": 1 },
        "businessSubmodule": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "group": {
          "enum": [
            "BUSINESS_CAPABILITY",
            "BACKGROUND_INTEGRATION",
            "DATA_INTEGRATION",
            "PROJECT_OPERATION",
            "API_SERVICE"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "stableEvidenceNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "design": { "$ref": "#/$defs/GovernanceFreeObject" },
        "analysisProvenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/GovernanceFreeObject" }
        },
        "uncertainties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "statement": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/GovernanceFreeObject" },
        "constraint": { "$ref": "#/$defs/GovernanceFreeObject" },
        "openQuestions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "GovernanceFreeValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/GovernanceFreeValue" }
        },
        { "$ref": "#/$defs/GovernanceFreeObject" }
      ]
    },
    "GovernanceFreeObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "governedFeatureId",
            "featureId",
            "featureVersionId",
            "claimId",
            "decisionId",
            "identityDecision",
            "authority",
            "authorizedBy",
            "reviewDisposition",
            "retirement"
          ]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/GovernanceFreeValue" }
    },
    "Provenance": {
      "type": "object",
      "required": ["producerType", "producerId", "producerVersion"],
      "properties": {
        "producerType": {
          "enum": ["DETERMINISTIC", "MODEL", "SKILL", "HUMAN"]
        },
        "producerId": { "type": "string", "minLength": 1 },
        "producerVersion": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
