{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.example/schemas/reverse-run-job-v1alpha1.json",
  "title": "ReverseRunJob",
  "type": "object",
  "required": ["id", "projectId", "status", "terminal", "cancelRequested", "request", "events", "run", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["QUEUED", "STARTED", "CANCEL_REQUESTED", "COMPLETED", "FAILED", "CANCELLED"] },
    "terminal": { "type": "boolean" },
    "cancelRequested": { "type": "boolean" },
    "request": { "$ref": "./reverse-run.schema.json" },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Event" } },
    "run": { "oneOf": [{ "$ref": "./reverse-run.schema.json#/$defs/ReverseRun" }, { "type": "null" }] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "Event": {
      "type": "object",
      "required": ["id", "jobId", "status", "details", "occurredAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "jobId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["QUEUED", "STARTED", "CANCEL_REQUESTED", "COMPLETED", "FAILED", "CANCELLED"] },
        "details": { "type": "object" },
        "occurredAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
