{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/workspace-analysis-job.schema.json",
  "title": "WorkspaceAnalysisJob",
  "type": "object",
  "required": ["id", "projectId", "sourceRegistrationId", "snapshotManifestId", "requestedMode", "resolvedMode", "baseRevisionId", "policyDigest", "workspaceExecutionProfileRevisionId", "implementationAuthorId", "runnerId", "purpose", "phase", "desiredState", "status", "version", "completedPhases", "outputs", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string" }, "projectId": { "type": "string" }, "sourceRegistrationId": { "type": "string" }, "snapshotManifestId": { "type": "string" },
    "requestedMode": { "enum": ["AUTO", "FULL", "INCREMENTAL"] }, "resolvedMode": { "enum": ["FULL", "INCREMENTAL"] },
    "baseRevisionId": { "type": ["string", "null"] }, "policyDigest": { "type": "string" },
    "workspaceExecutionProfileRevisionId": { "type": "string", "minLength": 1, "description": "Immutable Workspace-effective capability profile pinned for the complete run." },
    "implementationAuthorId": { "type": "string", "minLength": 1 },
    "runnerId": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["PUBLICATION", "EQUIVALENCE_VERIFICATION"] },
    "dataClassification": { "type": "string", "minLength": 1 },
    "productionEligible": { "type": "boolean" },
    "evaluationEvidenceType": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["SOURCE_SCAN", "FACT_COMMIT", "ANALYSIS", "RECONCILIATION", "EVALUATION", "PROJECTION", "PUBLISHING", "COMPLETED"] },
    "desiredState": { "enum": ["RUNNING", "PAUSED", "CANCELLED"] },
    "status": { "enum": ["RUNNING", "PAUSED", "COMPLETED", "FAILED", "CANCELLED"] },
    "version": { "type": "integer", "minimum": 1 },
    "completedPhases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "outputs": { "type": "object" },
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
