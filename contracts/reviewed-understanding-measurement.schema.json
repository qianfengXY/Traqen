{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/reviewed-understanding-measurement.schema.json",
  "title": "ReviewedUnderstandingMeasurement",
  "type": "object",
  "required": [
    "id", "projectId", "analysisRunId", "snapshotManifestId", "truthSetVersionId", "reviewerId", "independent",
    "productionInputDigest", "outputDigest", "anchorReviews", "candidateReviews",
    "relationReviews", "gapReviews", "reviewedAt", "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "analysisRunId": { "type": "string", "minLength": 1 },
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "truthSetVersionId": { "type": "string", "minLength": 1 },
    "reviewerId": { "type": "string", "minLength": 1 },
    "independent": { "type": "boolean" },
    "dataClassification": { "type": "string", "minLength": 1 },
    "productionEligible": { "type": "boolean" },
    "evaluationEvidenceType": { "type": "string", "minLength": 1 },
    "productionInputDigest": { "type": "string", "minLength": 1 },
    "outputDigest": { "type": "string", "minLength": 1 },
    "anchorReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchorId", "verdict"],
        "properties": {
          "anchorId": { "type": "string", "minLength": 1 },
          "artifactId": { "type": ["string", "null"] },
          "verdict": { "enum": ["OBSERVED", "MISSING"] }
        },
        "additionalProperties": false
      }
    },
    "candidateReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "verdict", "evidenceRefIds"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["CORRECT", "INCORRECT"] },
          "evidenceRefIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "relationReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship", "relationId", "verdict"],
        "properties": {
          "relationship": { "type": ["array", "object"] },
          "relationId": { "type": ["string", "null"] },
          "verdict": { "enum": ["OBSERVED", "MISSING", "ABSENT", "VIOLATION"] }
        },
        "additionalProperties": false
      }
    },
    "gapReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gapId", "verdict"],
        "properties": {
          "gapId": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["HONEST", "DISHONEST"] }
        },
        "additionalProperties": false
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    { "$ref": "#/$defs/IndependentReview" },
    { "$ref": "#/$defs/LocalReferenceSynthetic" }
  ],
  "$defs": {
    "IndependentReview": {
      "type": "object",
      "required": ["independent"],
      "properties": {
        "independent": { "const": true }
      },
      "not": {
        "anyOf": [
          {
            "required": ["dataClassification"],
            "properties": {
              "dataClassification": { "const": "LOCAL_DEVELOPMENT_REFERENCE_ONLY" }
            }
          },
          {
            "required": ["productionEligible"],
            "properties": {
              "productionEligible": { "const": false }
            }
          },
          {
            "required": ["evaluationEvidenceType"],
            "properties": {
              "evaluationEvidenceType": { "const": "LOCAL_REFERENCE_SYNTHETIC" }
            }
          }
        ]
      }
    },
    "LocalReferenceSynthetic": {
      "type": "object",
      "required": [
        "independent", "dataClassification", "productionEligible", "evaluationEvidenceType"
      ],
      "properties": {
        "independent": { "const": false },
        "dataClassification": { "const": "LOCAL_DEVELOPMENT_REFERENCE_ONLY" },
        "productionEligible": { "const": false },
        "evaluationEvidenceType": { "const": "LOCAL_REFERENCE_SYNTHETIC" }
      }
    }
  },
  "additionalProperties": false
}
