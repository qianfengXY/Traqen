{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traqen.dev/contracts/reviewed-understanding-measurement.schema.json",
  "title": "ReviewedUnderstandingMeasurement",
  "type": "object",
  "required": [
    "analysisRunId", "snapshotManifestId", "truthSetVersionId", "reviewerId", "independent",
    "productionInputDigest", "outputDigest", "anchorReviews", "candidateReviews",
    "relationReviews", "gapReviews", "reviewedAt"
  ],
  "properties": {
    "analysisRunId": { "type": "string", "minLength": 1 },
    "snapshotManifestId": { "type": "string", "minLength": 1 },
    "truthSetVersionId": { "type": "string", "minLength": 1 },
    "reviewerId": { "type": "string", "minLength": 1 },
    "independent": { "const": true },
    "productionInputDigest": { "type": "string", "minLength": 1 },
    "outputDigest": { "type": "string", "minLength": 1 },
    "anchorReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchorId", "verdict"],
        "properties": {
          "anchorId": { "type": "string", "minLength": 1 },
          "artifactId": { "type": ["string", "null"] },
          "verdict": { "enum": ["OBSERVED", "MISSING"] }
        },
        "additionalProperties": false
      }
    },
    "candidateReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "verdict", "evidenceRefIds"],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["CORRECT", "INCORRECT"] },
          "evidenceRefIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "relationReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship", "relationId", "verdict"],
        "properties": {
          "relationship": { "type": ["array", "object"] },
          "relationId": { "type": ["string", "null"] },
          "verdict": { "enum": ["OBSERVED", "MISSING", "ABSENT", "VIOLATION"] }
        },
        "additionalProperties": false
      }
    },
    "gapReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gapId", "verdict"],
        "properties": {
          "gapId": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["HONEST", "DISHONEST"] }
        },
        "additionalProperties": false
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
